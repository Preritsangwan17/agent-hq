{
  "type": "object",
  "required": ["sentences"],
  "properties": {
    "subject": {"type": ["string", "null"]},
    "sentences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["text", "kind", "fact_ids", "job_quote_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "kind": {"enum": ["salutation", "claim", "motivation", "job_reference", "logistics", "closing"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "job_quote_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
