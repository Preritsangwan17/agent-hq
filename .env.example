# Agent HQ secrets and runtime flags. Copy to .env (chmod 600). Never commit .env.
# Written by the first-run setup screen (loopback only): scrypt$<n>$<r>$<p>$<salt_b64>$<hash_b64>
HQ_PASSCODE_HASH=
# start.sh generates a random 32-byte hex secret if this is empty.
HQ_SESSION_SECRET=

# Optional
# HQ_PORT=8765
# HQ_LAN=1                                  # bind 0.0.0.0 for phone access (auth still required)
# HQ_ALLOWED_HOSTS=macbook.local,192.168.1.20   # extra Host/Origin names accepted when HQ_LAN=1
# HQ_FORCE_DRY_RUN=1

# Cloud model via xAI (Grok) instead of / next to the Claude CLI. Create a key at https://console.x.ai (API Keys),
# make sure the account has credit, and paste it here — never into chat, code or git. Settings › Budget › Cloud model.
# HQ_XAI_API_KEY=
